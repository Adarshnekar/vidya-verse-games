rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Connectivity test / health check
    match /_connectivity_test/{docId} {
      allow read, write: if true;
    }

    // Users: public read for profiles/leaderboard, owner write
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Scores: authenticated users can write their own scores; all can read
    match /scores/{scoreId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Progress: owner read and write
    match /progress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Leaderboard: public read; authenticated write
    match /leaderboard/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}